class="zwp-ui-fl zwp-ui-scorrect-label"> <span id="zwp-proofpop-grammar-word" class="zwp-ui-scrt-info">later</span> </div> </div> <div id="zwp-proofpop-grammar-cont"></div> </div> </div> </div> <!-- DELETE BLOCK --> <div id="zwp-proofpop-grammar-delete-blk"> <div id="zwp-proofpop-grammar-delete" class="zwp-ui-fl zwp-ui-sg-wrong-word zwp-ui-right-margin-small zwp-ui-bottom-margin-medium"> later on </div> </div> <div class="zwp-clearfix"> <span class="zwp-ui-zia-info-txt" id="zwp-proofpop-grammar-title">Tautological phrase</span> </div> <p id="zwp-proofpop-grammar-content" class="zwp-ui-zia-sug-discription"> Phrases like past history, when the same concept is repeated using different words, are considered tautologies. They make your writing monotonous and unnecessarily wordy. </p> <p id="zwp-proofpop-grammar-signup-button" class="zwp-ui-ms-pointer zwp-ui-zia-sug-discription" style="color: #4b90f2; text-decoration: underline"> View Suggestion </p> </div> <div class="zwp-ui-zia-dict-container zwp-clearfix zwp-ui-left-margin-small"> <div id="zwp-proofpop-grammar-bot-ignore" class="zwp-ui-sg-btn"></div> </div> <div class="zwp-ui-sg-btn-cont zwp-clearfix"> <div id="zwp-proofpop-grammar-report-tooltip" class="zwp-ui-fl zwp-pos-rel"> <div class="zwp-ui-fl zwp-ui-pos-rel zwp-ui-ms-pointer"> <svg class="zwp-ui-fl zwp-ui-ms-pointer" id="zwp-proofpop-grammar-report" width="16px" height="16px"> <use xlink:href="#zwp-zia-icon-flag" style="pointer-events: none"></use> </svg> </div> <div class="zwp-ui-zia-report-txt zwp-ui-left-margin-small zwp-ui-fl" data-title-is-message-html-encoded="true"> <div id="zwp-proofpop-grammar-report-text" class="zwp-ui-fl zwp-ui-rep-txt"></div> </div> <i id="zwp-proofpop-spc-report-grammar" class="zwp-ui-ms-pointer zwp-report-text-decoration zwp-ui-left-margin-small zwp-ui-fl"></i> <i class="zwp-ui-icon-info zwp-ui-fl zwp-ui-left-margin-small"></i> </div> <div id="zbp_grammar_tooltip" class="zwp-pos-rel" style="float: right"><span id="zbp_grammar_ext_i