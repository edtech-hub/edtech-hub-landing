div { margin: 0; padding: 0; border: 0; outline: 0; font-size: 100%; vertical-align: baseline; background: transparent; font-family: inherit; text-shadow: none; }

.quoteui.zcqut_anim{ opacity: 0; transition: all 1s cubic-bezier(0.25,0.8,0.25,1);}
.quoteui{top: 0px; left: 0; z-index: 11111; position: fixed; width: 100%; height: 100%; background-color:#fff;}
.quotebg{width: 100%; height: 100%; background-color: #fff;}

.ldngwhtbg{position: fixed; width: 100%; height: 100%; background-color: #fff;}
.posa { position:absolute;}
.pgload { bottom: 5px; margin: auto; left: 0; right: 0;}
.pgload div { font-size:100px; width:15px; display: inline-block; color:#000; animation-name: loading; animation-duration: 1.8s; animation-iteration-count: infinite; animation-fill-mode: both;}
.pgload div:nth-child(2) { animation-delay:.2s;}
.pgload div:nth-child(3) { animation-delay: .4s;}
@keyframes loading { 0% { opacity: .5;} 20% {opacity: 1;} 100% { opacity: .2;}}

.zcdqut{ display: block; margin: auto; left: 0; top: 0; right: 0; bottom: 0; width: 300px; height: 300px; border-radius: 100%; padding: 50px; background-color: #fff; box-shadow: 0px 0px 20px 5px #d9d9d9; font-size: 20px; color: #545454; position:absolute; text-align:center; z-index: 12;}
.zcdqut, .zcdqut * { text-align:center;}
.zcdqutmin { width: 50px; height: 50px; left: 95%; top: 90%; right: 0; bottom: 0; padding: 0px; position: fixed; display: block; margin: auto; text-align: center; z-index: 12; background-color: #fff; box-shadow: 0px 0px 10px 1px #a1a1a1; font-size: 20px; color: #545454; border-radius: 100%;}
.zcquttxt{ display: table-cell; vertical-align: middle; height: 200px; width: inherit;} 
.zcqutauth{ font-size: 15px; line-height: 15px; margin-top: 10px;}
.quoteic{position: absolute; left: 0; right: 0; top: 0; bottom: 0; margin: auto; height: 30px; cursor:pointer;}
.quotwin{width: 100%; height: 100%; background: transparent !important; border: none !important; box-shadow: none !important;}
.quotwin .mheader{border: none !important;}
.asas{box-shadow: 0px 0px 3px 5px #fff;}

.quoteui.quote-nite-mode { background-color: #15202b; }
.quote-nite-mode .zcdqut { background-color : #1a2b3c; box-shadow: 0px 0px 20px 5px #101b26; }
.quote-nite-mode .zcquttxt , .quote-nite-mode .pgload div { color : #fff; }
.quote-nite-mode .zcqutauth { color : #afb3b7; }

.quote-graymode.quoteui { background-color: #202020; }
.quote-graymode .zcdqut { background-color : #2B2B2B; box-shadow: 0px 0px 20px 5px rgba(0,0,0,0.1); }
.quote-graymode .zcquttxt , .quote-nite-mode .pgload div { color : #fff; }
.quote-graymode .zcqutauth { color : #B3B3B3; }

.permadiv, .zcoverlay.permadiv{position: fixed; z-index: 1000; top: 0; left: 0; width: 100%;  height: 100%; background: #f8f8f8;}
.permadiv ~ #officechat{visibility: hidden;}
.permaloading{position: fixed; top: 50%; left: 50%; margin: auto; width: 200px; margin-left: -100px; height: 200px; margin-top: -100px;}
.permaloading .msi-link-line:before{width: 80px; height: 80px; position: absolute; right: 60px; top: 0; font-size: 80px; color: #f3f3f3;}
.permaloading .infotxt{font-size: 20px; margin: 50px auto; text-align: center;}
.permaloading .pgloader {position: relative; border: 7px solid #f3f3f3; border-radius: 50%; border-top: 7px solid #4a90e2; width: 80px; height: 80px; z-index: 1; margin: auto; -webkit-animation: spin 2s linear infinite; animation: spin 2s linear infinite;}
.permaloading .pgloader.loaded{border: 7px solid #4a90e2;}


.zcloading-wrap { height: 100vh; width: 100vw;}
.posrel { position: relative; }
.flexM { display: flex; align-items: center; justify-content: center; }
.fdirC { flex-direction: column; }
.zcloading-img { width: 200px; }
.zcloading-title { font-size: 26px; color: #444; margin-top: 40px; }
.quote-nite-mode .zcloading-title{color: #e1e3e4;}
.zcwave { position: absolute; top: 75px; }
.zcwave-item { background-color: #EB3A38; position: relative; width: 18px; height: 18px; border-radius: 100%; display: inline-flex; margin-right: 13px; animation: wave 1.3s linear infinite; }
.zcwave-item:nth-child(2) { animation-delay: -1.1s; }
.zcwave-item:nth-child(3) { animation-delay: -0.9s; }
.zcwave-item:last-child { margin-right: 0; }

@keyframes wave {
    0%, 60%, 100% { transform: initial; }
    30% { transform: translateY(-15px); }
}

@-webkit-keyframes spin { 0% { -webkit-transform: rotate(0deg); } 100% { -webkit-transform: rotate(360deg); } }
@keyframes spin { 0% { transform: rotate(0deg); }  100% { transform: rotate(360deg); } }

</style>
<script nonce="gSFzZ/Zl3hsPg/VOhWaoWg==">var dc_isdarkmode = ( false && true ) ? ( ( typeof DesktopModule !== "undefined" && typeof DesktopModule.isDarkMode === "function" ) ? DesktopModule.isDarkMode() : electron.remote.systemPreferences.isDarkMode() ) : false ;
var dc_isgraymode = false ;
var dc_isclassicmode = false ;
var bglink = "https://static.zohocdn.com/chat/source/officechat/images/default";		
var iscliqloader = false;
var author = zcg._quote.author;
var quotetxt = zcg._quote.content.replace(/<b>/g,'<span class="font50">')
.replace(/<\/b>/g,'</span>');
var quote_mode_class = dc_isdarkmode ? "quote-nite-mode"  + ( dc_isgraymode || dc_isclassicmode ? " quote-graymode" : ""): "";  
var quote_html = '<div id="quoteui" type="quote" class="quoteui '+quote_mode_class+'">'+
'<div id="quotebg" class="quotebg"></div>'+
'<div id="quotecontainer" class="zcdqut">'+
'<div class="zcquttxt">'+ quotetxt +
'<div class="zcqutauth">'+ author +'</div>'+
'</div>'+
'<div class="pgload posa"><div>.</div><div>.</div><div>.</div></div>'+
'</div>'+
'</div>';
var renderQuote = function()
{
var html = "";
if(iscliqloader){
quote_html = 
'<div id="quoteui" type="quote" class="quoteui '+quote_mode_class+'">'+
'<div id="quotebg" class="zcloading-wrap flexM">'+
'<div class="flexM fdirC">'+
'<div class="flexM posrel">'+
'<img class="zcloading-img" id="cliqlogo" src="logo.png">'+
'<span class="zcwave">'+
'<span class="zcwave-item"></span>'+
'<span class="zcwave-item"></span>'+
'<span class="zcwave-item"></span>'+
'</span>'+
'</div>'+
'<div class="zcloading-title">Chat that\'s built for Work</div>'+
'</div>'+
'</div>'+
'</div>'
}

document.body.innerHTML += html + quote_html;
if(iscliqloader){
document.getElementById("cliqlogo").src = bglink + (dc_isdarkmode ? (dc_isgraymode || dc_isclassicmode ? '/cliqloader_logo_withoutdots_grey.svg' : '/cliqloader_logo_withoutdots_dark.svg') : '/cliqloader_logo_withoutdots.svg');	//No I18N
}
else{
document.getElementById("quotebg").style.background = 'url("' + bglink + ( dc_isdarkmode ? (dc_isgraymode || dc_isclassicmode ? '/grey_loading-bg.png' : '/dark_loading-bg.png') : '/loading-bg.jpg' ) + '")';	//No I18N
}
}
renderQuote();</script>
